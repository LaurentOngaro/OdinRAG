{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "Minimax/Minimax M3",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "code",
  "instructions": [
    "AGENTS.md",
    "README.md",
    "TODO.md",
    ".kilo/agents/odin-gamedev.md",
    ".kilo/skills/markdown-style/SKILL.md",
    "code/projects/PVG03_RPG/AGENTS.md",
    "code/projects/PVG03_RPG/.kilo/agents/odin-project.md"
  ],
  "skills": {
    "paths": [
      ".kilo/skills"
    ]
  },
  "permission": {
    "bash": {
      "python *": "allow",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Test-Path *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "Remove-Item -Recurse -Force *": "deny",
      "rm -rf *": "deny",
      "git push --force *": "deny"
    },
    "edit": {
      "odin-knowledge-base/courses/**/!README.md": "deny",
      "odin-knowledge-base/docs/**/!README.md": "deny",
      "_Helpers/logs/**": "deny",
      "**/__pycache__/**": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "snapshot": true
}
