[
  {
    "context": "Editor",
    "bindings": {
      "f8": "editor::GoToDiagnostic",
      "shift-f8": "editor::GoToPreviousDiagnostic"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-b": [
        "task::Spawn",
        "Odin: Build Debug"
      ],
      "f5": [
        "task::Spawn",
        "Odin: Run Debug"
      ]
    }
  }
]