# gitattributes - OdinRAG line endings and binary rules
# Set default behavior to automatically normalize line endings to LF on commit.
* text=auto eol=lf

# Explicit text file types (enforce LF)
*.odin text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows scripts (preserve CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.blend binary
*.zip binary
*.png binary
*.wav binary
*.ogg binary
*.ico binary
*.pdf binary
