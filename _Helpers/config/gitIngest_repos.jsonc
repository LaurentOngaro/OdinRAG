{
  // Repo map for `_Helpers/scripts/scrapers/build_gitingest.py`.
  //
  // Each entry:
  //   "id":        short slug used in the output filename
  //   "src":       absolute path to the LOCAL clone (Windows-style)
  //   "subfolder": subfolder under `odin-knowledge-base/gitIngest/`
  //   "skip":      if true, the entry is excluded from a default run
  //                (kept in the file as documentation of what was tried)
  //   "priority":  1 = highest, used by `--only <id>` and ordering
  //   "max_size":  bytes; files larger than this are skipped by gitingest (-s)
  //   "exclude":   list of glob patterns passed to gitingest (-e)
  //   "notes":     free-form human note
  //
  // Edit this file to add/remove repos. The script picks up changes on next run.

