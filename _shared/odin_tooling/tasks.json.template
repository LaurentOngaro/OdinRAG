{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  //
  // Tasks.json template - copy to <project>/.vscode/tasks.json and adjust
  // paths if needed. All file paths use ${workspaceFolder} so the file is
  // portable across machines and OS.
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "shared"
  },
  "problemMatcher": {
    "owner": "odin",
    "source": "Odin",
    "fileLocation": "absolute",
    "pattern": {
      "regexp": "^(.*?)(\\((\\d+):(\\d+)\\))\\s+(Syntax\\s+)?(Error|Warning):\\s+(.+)$",
      "file": 1,
      "line": 3,
      "column": 4,
      "severity": 6,
      "message": 7
    }
  },
  "tasks": [
    {
      "label": "[BUILD] Create build folder (debug)",
      "type": "process",
      "command": "mkdir",
      "args": [
        "-p",
        "${workspaceFolder}/build/debug"
      ],
      "presentation": {
        "reveal": "silent"
      },
      "linux": {
        "command": "mkdir",
        "args": [
          "-p",
          "${workspaceFolder}/build/debug"
        ]
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/C",
          "if not exist ${workspaceFolder}\\build\\debug mkdir ${workspaceFolder}\\build\\debug"
        ]
      }
    },
    {
      "label": "[BUILD] Create build folder (release)",
      "type": "process",
      "command": "mkdir",
      "args": [
        "-p",
        "${workspaceFolder}/build/release"
      ],
      "presentation": {
        "reveal": "silent"
      },
      "linux": {
        "command": "mkdir",
        "args": [
          "-p",
          "${workspaceFolder}/build/release"
        ]
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/C",
          "if not exist ${workspaceFolder}\\build\\release mkdir ${workspaceFolder}\\build\\release"
        ]
      }
    },
    {
      "label": "[BUILD] Delete build folder",
      "type": "process",
      "presentation": {
        "reveal": "silent"
      },
      "command": "rm",
      "args": [
        "-rf",
        "${workspaceFolder}/build"
      ],
      "linux": {
        "command": "rm",
        "args": [
          "-rf",
          "${workspaceFolder}/build"
        ]
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/C",
          "if exist ${workspaceFolder}\\build\\ rmdir /s /q ${workspaceFolder}\\build"
        ]
      }
    },
    {
      "label": "[BUILD] Build Source using Odin (debug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${workspaceFolder}\\source",
        "-out:${workspaceFolderBasename}.exe",
        "-debug",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-missing-blank-lines-between-procs",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\debug"
      },
      "dependsOn": "[BUILD] Create build folder (debug)"
    },
    {
      "label": "[BUILD] Build Source using Odin (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${workspaceFolder}\\source",
        "-out:${workspaceFolderBasename}.exe",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-missing-blank-lines-between-procs",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\release"
      },
      "dependsOn": "[BUILD] Create build folder (release)"
    },
    {
      "label": "[BUILD] Build the current file using Odin (debug)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${file}",
        "-file",
        "-out:${fileBasename}.exe",
        "-debug",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-missing-blank-lines-between-procs",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\debug"
      },
      "dependsOn": "[BUILD] Create build folder (debug)"
    },
    {
      "label": "[BUILD] Build the current file using Odin (release)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${file}",
        "-file",
        "-out:${fileBasename}.exe",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-missing-blank-lines-between-procs",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\release"
      },
      "dependsOn": "[BUILD] Create build folder (release)"
    },
    {
      "label": "[BUILD] build_and_run on Source (debug)",
      "group": "build",
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\build_and_run.bat",
        "build",
        "--src",
        "${workspaceFolder}\\source",
        "--out",
        "${workspaceFolder}\\build\\debug\\${workspaceFolderBasename}.exe",
        "--exec",
        "--debug"
      ]
    },
    {
      "label": "[BUILD] build_and_run on Source (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\build_and_run.bat",
        "build",
        "--src",
        "${workspaceFolder}\\source",
        "--out",
        "${workspaceFolder}\\build\\release\\${workspaceFolderBasename}.exe",
        "--exec"
      ]
    },
    {
      "label": "[BUILD] build_and_run on Source (Raddebug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\build_and_run.bat",
        "build",
        "--src",
        "${workspaceFolder}\\source",
        "--out",
        "${workspaceFolder}\\build\\debug\\${workspaceFolderBasename}.exe",
        "--verbose",
        "--debug",
        "--wipe",
        "--raddebugger"
      ]
    },
    {
      "label": "[DEV] Check and Format (CI pipeline)",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\check_and_format.bat",
        "${workspaceFolder}\\source"
      ],
      "problemMatcher": [
        "$odin"
      ]
    },
    {
      "label": "[DEV] Run Linter on Current File",
      "type": "shell",
      "command": "${env:FLD_SCRIPTS}/Windows/04c_dev_scripts/run_linters.bat",
      "args": [
        "${file}"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[RUN] Run the current file (debug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "${fileBasename}.exe",
      "options": {
        "cwd": "${workspaceFolder}\\build\\debug"
      }
    },
    {
      "label": "[RUN] Run the current file (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "${fileBasename}.exe",
      "options": {
        "cwd": "${workspaceFolder}\\build\\release"
      }
    }
  ]
}
