{
  // TEMPLATE - seeded into a new Odin project by
  // _shared/odin_tooling/sync-tooling.ps1 (only if the file is missing, or
  // always with -Force). Do not edit in place: edit the template instead.
  //
  // [WIN] / [LIN] PREFIX CONVENTION
  //   [WIN] ...   Windows: powershell / cmd, _tools/build_and_run.bat,
  //               .exe binaries, cppvsdbg (Visual Studio debugger).
  //   [LIN] ...   Linux/macOS: pwsh / bash, _tools/build_and_run.sh,
  //               extension-less binaries, cppdbg + gdb.
  //   (no prefix)  cross-platform tasks (mkdir / rm / python).
  //
  // The [WIN] and [LIN] members of a pair carry identical arguments apart from
  // path separators and the binary extension. Keep them in sync when editing.
  //
  // A companion launch.json with the matching [WIN] / [LIN] configurations is
  // seeded the same way.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[BUILD] Create build folder (debug)",
      "type": "process",
      "command": "mkdir",
      "args": [
        "-p",
        "${workspaceFolder}/build/debug"
      ],
      "presentation": {
        "reveal": "silent"
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/C",
          "if not exist ${workspaceFolder}\\build\\debug mkdir ${workspaceFolder}\\build\\debug"
        ]
      }
    },
    {
      "label": "[BUILD] Create build folder (release)",
      "type": "process",
      "command": "mkdir",
      "args": [
        "-p",
        "${workspaceFolder}/build/release"
      ],
      "presentation": {
        "reveal": "silent"
      },
      "windows": {
        "command": "cmd",
        "args": [
          "/C",
          "if not exist ${workspaceFolder}\\build\\release mkdir ${workspaceFolder}\\build\\release"
        ]
      }
    },
    {
      "label": "[BUILD] Delete build folder",
      "type": "process",
      "presentation": {
        "reveal": "silent"
      },
      "command": "rm",
      "args": [
        "-rf",
        "${workspaceFolder}/build"
      ],
      "windows": {
        "command": "cmd",
        "args": [
          "/C",
          "if exist ${workspaceFolder}\\build\\ rmdir /s /q ${workspaceFolder}\\build"
        ]
      }
    },
    {
      "label": "[WIN] [BUILD] Build Source using Odin (debug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${workspaceFolder}\\source",
        "-out:${workspaceFolderBasename}.exe",
        "-debug",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\debug"
      },
      "dependsOn": "[BUILD] Create build folder (debug)"
    },
    {
      "label": "[LIN] [BUILD] Build Source using Odin (debug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${workspaceFolder}/source",
        "-out:${workspaceFolderBasename}",
        "-debug",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build/debug"
      },
      "dependsOn": "[BUILD] Create build folder (debug)"
    },
    {
      "label": "[WIN] [BUILD] Build Source using Odin (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${workspaceFolder}\\source",
        "-out:${workspaceFolderBasename}.exe",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\release"
      },
      "dependsOn": "[BUILD] Create build folder (release)"
    },
    {
      "label": "[LIN] [BUILD] Build Source using Odin (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${workspaceFolder}/source",
        "-out:${workspaceFolderBasename}",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build/release"
      },
      "dependsOn": "[BUILD] Create build folder (release)"
    },
    {
      "label": "[WIN] [BUILD] Build the current file using Odin (debug)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${file}",
        "-file",
        "-out:${fileBasename}.exe",
        "-debug",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\debug"
      },
      "dependsOn": "[BUILD] Create build folder (debug)"
    },
    {
      "label": "[LIN] [BUILD] Build the current file using Odin (debug)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${file}",
        "-file",
        "-out:${fileBasename}",
        "-debug",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build/debug"
      },
      "dependsOn": "[BUILD] Create build folder (debug)"
    },
    {
      "label": "[WIN] [BUILD] Build the current file using Odin (release)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${file}",
        "-file",
        "-out:${fileBasename}.exe",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\build\\release"
      },
      "dependsOn": "[BUILD] Create build folder (release)"
    },
    {
      "label": "[LIN] [BUILD] Build the current file using Odin (release)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "process",
      "command": "odin",
      "args": [
        "build",
        "${file}",
        "-file",
        "-out:${fileBasename}",
        "-thread-count:14",
        "-vet-unused",
        "-vet-unused-variables",
        "-vet-unused-imports",
        "-vet-shadowing",
        "-vet-style",
        "-vet-semicolon",
        "-vet-cast",
        "-use-separate-modules"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build/release"
      },
      "dependsOn": "[BUILD] Create build folder (release)"
    },
    {
      "label": "[WIN] [BUILD] build_and_run on Source (debug)",
      "group": "build",
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\build_and_run.bat",
        "build",
        "--src",
        "${workspaceFolder}\\source",
        "--out",
        "${workspaceFolder}\\build\\debug\\${workspaceFolderBasename}.exe",
        "--no-pause",
        "--debug"
      ]
    },
    {
      "label": "[LIN] [BUILD] build_and_run on Source (debug)",
      "group": "build",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/_tools/build_and_run.sh",
        "build",
        "--src",
        "${workspaceFolder}/source",
        "--out",
        "${workspaceFolder}/build/debug/${workspaceFolderBasename}",
        "--no-pause",
        "--debug"
      ]
    },
    {
      "label": "[WIN] [BUILD] build_and_run on Source (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\build_and_run.bat",
        "build",
        "--src",
        "${workspaceFolder}\\source",
        "--out",
        "${workspaceFolder}\\build\\release\\${workspaceFolderBasename}.exe",
        "--no-pause"
      ]
    },
    {
      "label": "[LIN] [BUILD] build_and_run on Source (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/_tools/build_and_run.sh",
        "build",
        "--src",
        "${workspaceFolder}/source",
        "--out",
        "${workspaceFolder}/build/release/${workspaceFolderBasename}",
        "--no-pause"
      ]
    },
    {
      "label": "[WIN] [BUILD] build_and_run on Source (Raddebug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\build_and_run.bat",
        "build",
        "--src",
        "${workspaceFolder}\\source",
        "--out",
        "${workspaceFolder}\\build\\debug\\${workspaceFolderBasename}.exe",
        "--verbose",
        "--debug",
        "--wipe",
        "--no-pause",
        "--raddebugger"
      ]
    },
    {
      "label": "[LIN] [BUILD] build_and_run on Source (Raddebug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/_tools/build_and_run.sh",
        "build",
        "--src",
        "${workspaceFolder}/source",
        "--out",
        "${workspaceFolder}/build/debug/${workspaceFolderBasename}",
        "--verbose",
        "--debug",
        "--wipe",
        "--no-pause",
        "--raddebugger"
      ]
    },
    {
      "label": "[DEV] Check and Format (CI pipeline)",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "type": "process",
      "command": "cmd",
      "args": [
        "/c",
        "${workspaceFolder}\\_tools\\check_and_format.bat",
        "${workspaceFolder}\\source"
      ],
      "problemMatcher": [
        "$odin"
      ]
    },
    {
      "label": "[WIN] [DEV] Run Linter on Current File",
      "type": "shell",
      "command": "${env:FLD_SCRIPTS}\\Windows\\04c_dev_scripts\\run_linters.bat",
      "args": [
        "${file}"
      ],
      "problemMatcher": [
        "$msCompile"
      ],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "[WIN] [RUN] Run the current file (debug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "${workspaceFolderBasename}.exe",
      "options": {
        "cwd": "${workspaceFolder}\\build\\debug"
      }
    },
    {
      "label": "[LIN] [RUN] Run the current file (debug)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "${workspaceFolderBasename}",
      "options": {
        "cwd": "${workspaceFolder}/build/debug"
      }
    },
    {
      "label": "[WIN] [RUN] Run the current file (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "${workspaceFolderBasename}.exe",
      "options": {
        "cwd": "${workspaceFolder}\\build\\release"
      }
    },
    {
      "label": "[LIN] [RUN] Run the current file (release)",
      "group": {
        "kind": "build"
      },
      "type": "process",
      "command": "${workspaceFolderBasename}",
      "options": {
        "cwd": "${workspaceFolder}/build/release"
      }
    }
  ]
}
