{
  "editor.rulers": [180],
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    }
  },
  "[odin]": {
    "editor.defaultFormatter": "DanielGavin.ols",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[powershell]": {
    "files.eol": "\r\n"
  },
  "[bat]": {
    "files.eol": "\r\n"
  },
  "search.exclude": {
    "build/**": true,
    "**/node_modules": true
  }
}
