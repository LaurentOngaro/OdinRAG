{
  "version": "2.0.0",
  // =============================================================================
  // INPUTS - shared between Family B launch configs (project picker)
  // =============================================================================
  //
  // `pvProjectDir` is the project root passed to odin_task.ps1 via `-Cwd`.
  // It is consumed ONLY by Family B launch configs (the [Select] family).
  //
  // Why `pickString` and not `command`:
  //   - `command` input would let us auto-detect projects from
  //     `code/projects/*`, but on this machine VS Code refuses to spawn
  //     any executable from a `command` input (PATH not inherited,
  //     ${workspaceFolder} not resolved in the `command` field).
  //   - `pickString` is native, supports a `default` value, and the user
  //     just presses Enter to validate. No hang risk.
  //   - The list is HARDCODED. To add a new sub-project, append a new
  //     entry in `options` below (and mirror it in `default` if you want
  //     it pre-selected). No script needed for the common case.
  "inputs": [
    {
      "id": "pvProjectDir",
      "type": "pickString",
      "description": "Select the project to build (Family B only)",
      "options": [
        "${workspaceFolder}/code/projects/PVG03_RPG",
        "${workspaceFolder}/code/projects/PVG02_Metroidvania",
        "${workspaceFolder}/code/projects/Odin_Skeleton"
      ],
      "default": "${workspaceFolder}/code/projects/PVG03_RPG"
    }
  ],
  "tasks": [
    // ===========================================================================
    // Family A - GENERIC tasks, project detected from ${file}
    // ===========================================================================
    // These tasks use ${file} (the active editor tab) to detect the project via
    // odin_task.ps1. They DO NOT consume pvProjectDir - no pickString prompt.
    // Use these when you have an .odin file open under the project you want to build.
    {
      "label": "[BUILD] odin_task (debug)",
      "detail": "Build (debug) the project containing the active file (${file}). No pickstring prompt - the project is inferred from the file path.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-debug",
        "-Exec"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[BUILD] odin_task (release)",
      "detail": "Build (release, -o:speed) the project containing the active file (${file}). No pickstring prompt.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-release",
        "-Exec"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[BUILD] Hot Reload with odin_task (Build DLL)",
      "detail": "Build the hot-reload DLL for the project containing the active file (${file}). No pickstring prompt.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[BUILD] odin_task (Debug + Raddebugger)",
      "detail": "Build the debug binary then launch RAD Debugger (raddbg.exe) on it. Project detected from ${file}. No pickstring prompt.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-raddebug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[BUILD+RUN] odin_task (debug)",
      "detail": "Build then run the debug binary. Project detected from ${file}. No pickstring prompt.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "run-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[BUILD+RUN] odin_task (release)",
      "detail": "Build then run the release binary. Project detected from ${file}. No pickstring prompt.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "run-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[DEV] odin_task Check Source folder",
      "detail": "Run odin check (vet + strict-style) on the project containing the active file (${file}). No pickstring prompt.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    // ===========================================================================
    // Family B - PROJECT-PICKED tasks, project chosen via pvProjectDir pickstring
        // ===========================================================================
    // Family B - PROJECT-PICKED tasks, project chosen via pvProjectDir pickstring
    // ===========================================================================
    // The pickString is declared in the "inputs" section at the top of this file.
    // The same pickString is shared by all 5 Family B tasks, so changing the
    // picked project switches all modes at once.
    //
    // The launch configs in .vscode/launch.json (the [Select] family) reference
    // these tasks. There is ONE task per mode, NOT one task per (project, mode)
    // combination - the pickString picks the project, the mode is in the label.
    //
    // To add a new sub-project: append the new path to the `options` array in
    // the inputs section at the top. No task duplication needed.
    // ===========================================================================
    {
      "label": "[Select] build (debug)",
      "detail": "Build (debug) the project picked via the pvProjectDir pickstring. The project is NOT taken from ${file}, so you can be anywhere in the workspace.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-Mode",
        "build-debug",
        "-Exec",
        "-Cwd",
        "${input:pvProjectDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[Select] build (release)",
      "detail": "Build (release, -o:speed) the project picked via the pvProjectDir pickstring.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-Mode",
        "build-release",
        "-Exec",
        "-Cwd",
        "${input:pvProjectDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[Select] build (check)",
      "detail": "Run odin check (vet + strict-style) on the project picked via the pvProjectDir pickstring.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-Mode",
        "check",
        "-Cwd",
        "${input:pvProjectDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[Select] build (debug + run)",
      "detail": "Build then run the project picked via the pvProjectDir pickstring.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-Mode",
        "run-debug",
        "-Cwd",
        "${input:pvProjectDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
    },
    {
      "label": "[Select] build (release + run)",
      "detail": "Build then run the release binary of the project picked via the pvProjectDir pickstring.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-Mode",
        "run-release",
        "-Cwd",
        "${input:pvProjectDir}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
    },
// ===========================================================================
    // Diagnostic / utility tasks (unchanged)
    // ===========================================================================
    {
      "label": "[DIAG] Audit Consistency READMEs",
      "detail": "Audit README <-> filesystem coherence (wikilinks, missing files, unlisted files). Use --fail-on-error in CI.",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/auditReadmeCoherence.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
    },
    {
      "label": "[DIAG] Vault Diagnostic",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/vaultDiagnostic.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Walk the whole repo and report issues per file: filename structure, frontmatter, content (H1 vs filename, long dashes). Use --fail-on-error in CI to break the build on any frontmatter error."
    },
    {
      "label": "[DIAG] Validate Frontmatter",
      "detail": "Validate every .md file's YAML frontmatter against the 8-field OdinRAG schema. Exits 2 on any error. Runs an auto-fix for long dashes (en-dash/em-dash/horizontal bar -> ASCII '-').",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/validateFrontmatter.py",
        "--fail-on-error"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
    },
    {
      "label": "[DIAG] Audit with code_auditor (single file prompt)",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/code_auditor/code_auditor.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "detail": "Prompts for a file or path then runs code_auditor.py against it (use Run -> Input variant). Default: prints to stdout."
    },
    {
      "label": "[PUBLISH] publish_public --check (dry-run)",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/publish_public.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "detail": "Dry-run: regenerate public from main locally, audit, no pushes. Use to preview before the real publish.",
      "group": "test"
    },
    {
      "label": "[PUBLISH] publish_public --full (private + regen + public)",
      "detail": "Daily publish flow: push main to private, regenerate public (filtered), push public to remote. Refuses on dirty working tree. Uses --force-with-lease on the public push.",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/publish_public.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "[PUBLISH] publish_public --skip-private",
      "detail": "Same as [PUBLISH] publish_public --full but skip the private push (use when you already pushed main to private manually).",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/publish_public.py",
        "--skip-private"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "[SCRAPE] Run all scrapers (interactive)",
      "detail": "Launch every scraper in _Helpers/scripts/scrapers/ interactively. Lists each with its description and prompts [O/n/q] before launch. Supports --check (dry-run inventory), --yes (non-interactive), --only <substr>, --skip <substr> (both repeatable).",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/scrapers/run_all_scrapers.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": [],
    }
  ]
}