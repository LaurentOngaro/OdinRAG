{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "[BUILD] odin_task (debug)",
      "detail": "Build (debug) the project containing the active file. Project is detected from ${file} (must live under code/projects/<project>/).",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[BUILD] odin_task (release)",
      "detail": "Build (release, -o:speed) the project containing the active file.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[BUILD] Hot Reload with odin_task (Build DLL)",
      "detail": "Build the hot-reload DLL for the project containing the active file.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[BUILD] odin_task (Debug + Raddebugger)",
      "detail": "Build the debug binary then launch RAD Debugger (raddbg.exe from EpicGames/raddebugger) on it. If raddbg.exe is not in PATH, the build still succeeds and the binary path is printed.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "build-raddebug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[BUILD+RUN] odin_task (debug)",
      "detail": "Build then run the debug binary for the project containing the active file.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "run-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[BUILD+RUN] odin_task (release)",
      "detail": "Build then run the release binary for the project containing the active file.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "run-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
    },
    {
      "label": "[DEV] odin_task Check Source folder",
      "detail": "Run odin check (vet + strict-style) on the project containing the active file.",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/_Helpers/scripts/dev/odin_task.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-ActiveFile",
        "${file}",
        "-Mode",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [],
    },
    {
      "label": "[DIAG] Audit Consistency READMEs",
      "detail": "Audit README <-> filesystem coherence (wikilinks, missing files, unlisted files). Use --fail-on-error in CI.",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/auditReadmeCoherence.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
    },
    {
      "label": "[DIAG] Vault Diagnostic",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/vaultDiagnostic.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "detail": "Walk the whole repo and report issues per file: filename structure, frontmatter, content (H1 vs filename, long dashes). Use --fail-on-error in CI to break the build on any frontmatter error."
    },
    {
      "label": "[DIAG] Validate Frontmatter",
      "detail": "Validate every .md file's YAML frontmatter against the 8-field OdinRAG schema. Exits 2 on any error. Runs an auto-fix for long dashes (en-dash/em-dash/horizontal bar -> ASCII '-').",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/validateFrontmatter.py",
        "--fail-on-error"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
    },
    {
      "label": "[DIAG] Audit with code_auditor (single file prompt)",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/code_auditor/code_auditor.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "detail": "Prompts for a file or path then runs code_auditor.py against it (use Run -> Input variant). Default: prints to stdout."
    },
    {
      "label": "[PUBLISH] publish_public --check (dry-run)",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/publish_public.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "detail": "Dry-run: regenerate public from main locally, audit, no pushes. Use to preview before the real publish.",
      "group": "test"
    },
    {
      "label": "[PUBLISH] publish_public --full (private + regen + public)",
      "detail": "Daily publish flow: push main to private, regenerate public (filtered), push public to remote. Refuses on dirty working tree. Uses --force-with-lease on the public push.",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/publish_public.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "[PUBLISH] publish_public --skip-private",
      "detail": "Same as [PUBLISH] publish_public --full but skip the private push (use when you already pushed main to private manually).",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/diagnostic/publish_public.py",
        "--skip-private"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "[SCRAPE] Run all scrapers (interactive)",
      "detail": "Launch every scraper in _Helpers/scripts/scrapers/ interactively. Lists each with its description and prompts [O/n/q] before launch. Supports --check (dry-run inventory), --yes (non-interactive), --only <substr>, --skip <substr> (both repeatable).",
      "type": "process",
      "command": "python",
      "args": [
        "_Helpers/scripts/scrapers/run_all_scrapers.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "problemMatcher": [],
    }
  ]
}